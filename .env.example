# ════════════════════════════════════════════════════════════════
# ForenHive — Variables d'environnement (template)
# ────────────────────────────────────────────────────────────────
# Copier ce fichier en `.env` et remplir les valeurs sensibles.
# NE JAMAIS commiter `.env` en clair sur git (déjà dans .gitignore).
# ════════════════════════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=forenhive
POSTGRES_PASSWORD=change_me_password          # générer 32+ chars
POSTGRES_DB=forenhive
POSTGRES_PORT=5432

# ─── Elasticsearch + Logstash ───────────────────────────────────
ES_HOST=elasticsearch
ES_PORT=9200
ES_INDEX_LOGS=honeypot-logs
ES_INDEX_FORENSIC=forensic-analysis
ES_JAVA_OPTS=-Xms1g -Xmx1g
LS_JAVA_OPTS=-Xms512m -Xmx512m

# ─── Zeek (capture passive) ─────────────────────────────────────
ZEEK_INTERFACE=eno12399                       # interface réseau hôte

# ─── Backend FastAPI ────────────────────────────────────────────
SECRET_KEY=change_me_jwt_secret               # openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret               # idem (alias historique)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap admin créé au premier démarrage
BOOTSTRAP_ADMIN_EMAIL=admin@forenhive.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026        # à changer après login

# ─── Ollama + Mistral (LLM local, CPU-only) ─────────────────────
OLLAMA_HOST=forenhive-ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral:7b-instruct-q4_K_M       # 4,4 Go

# ─── APIs externes de threat intelligence ───────────────────────
ABUSEIPDB_API_KEY=                             # gratuit 1000 req/jour
VIRUSTOTAL_API_KEY=                            # Public API 500 req/jour
VT_API_KEY=                                    # alias historique (idem VIRUSTOTAL_API_KEY)
MAXMIND_LICENSE_KEY=                           # gratuit avec compte
SHODAN_KEY=                                    # optionnel (Shodan payant)

# ─── Notifications (optionnel) ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_NUMBER=                              # ex: whatsapp:+14155238886
DEST_WA=                                       # ex: whatsapp:+216XXXXXXXX

# ─── RFC 3161 — Time Stamp Authority ────────────────────────────
TSA_URL=https://freetsa.org/tsr                # défaut: freetsa.org (gratuit)

# ─── Forensic Engine ────────────────────────────────────────────
ENGINE_INTERVAL_MINUTES=5                      # cron interne

# ─── Frontend nginx ─────────────────────────────────────────────
DOMAIN=localhost
