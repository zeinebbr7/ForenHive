# ════════════════════════════════════════════════════════════════
# ForenHive — Variables d'environnement (template)
# ────────────────────────────────────────────────────────────────
# Copier ce fichier en `.env` et remplir les valeurs sensibles.
# NE JAMAIS commiter `.env` en clair sur git (déjà dans .gitignore).
# ════════════════════════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=        # générer 32+ chars
POSTGRES_DB=
POSTGRES_PORT=

# ─── Elasticsearch + Logstash ───────────────────────────────────
ES_HOST=
ES_PORT=
ES_INDEX_LOGS=
ES_INDEX_FORENSIC=
ES_JAVA_OPTS=

# ── Logstash ──────────────────────────────
LS_JAVA_OPTS=

# ─── Zeek (capture passive) ─────────────────────────────────────
ZEEK_INTERFACE=                    # interface réseau hôte

# ─── Backend FastAPI ────────────────────────────────────────────
SECRET_KEY=             # openssl rand -hex 32
JWT_SECRET=              # idem (alias historique)
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
API_PORT=
DEBUG=
CORS_ORIGINS=

# Bootstrap admin créé au premier démarrage
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=     # à changer après login

# ─── Ollama + Mistral (LLM local, CPU-only) ─────────────────────
OLLAMA_HOST=
OLLAMA_PORT=
OLLAMA_MODEL=      # 4,4 Go

# ─── APIs externes de threat intelligence ───────────────────────
ABUSEIPDB_API_KEY=                             # gratuit 1000 req/jour
VIRUSTOTAL_API_KEY=                            # Public API 500 req/jour                                 # alias historique (idem VIRUSTOTAL_API_KEY)
MAXMIND_LICENSE_KEY=                           # gratuit avec compte
SHODAN_KEY=                                    # optionnel (Shodan payant)

# ─── Notifications (optionnel) ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_NUMBER= 
TWILIO_PHONE=                             # ex: whatsapp:+14155238886
DEST_WA=        
DEST_PHONE=                               # ex: whatsapp:+216XXXXXXXX

# ── Nginx ─────────────────────────────────
DOMAIN=

# ─── RFC 3161 — Time Stamp Authority ────────────────────────────
TSA_URL=               # défaut: freetsa.org (gratuit)

# ─── Forensic Engine ────────────────────────────────────────────
ENGINE_INTERVAL_MINUTES=5                      # cron interne

# ── Email Alerts (SMTP) ───────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=
ALERT_RECIPIENTS=
DEST_WA_EXTRA=

# ── Groq (HIVE chatbot LLM) ───────────────
GROQ_API_KEY=
GROQ_MODEL=
