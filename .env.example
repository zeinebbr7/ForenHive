# ══════════════════════════════════════════
# ForenHive — Variables d'environnement
# Copier ce fichier en .env et remplir
# ══════════════════════════════════════════

# ── PostgreSQL ────────────────────────────
POSTGRES_USER=forenhive
POSTGRES_PASSWORD=change_me_password
POSTGRES_DB=forenhive
POSTGRES_PORT=5432

# ── Elasticsearch ─────────────────────────
ES_HOST=elasticsearch
ES_PORT=9200
ES_INDEX_LOGS=honeypot-logs
ES_INDEX_FORENSIC=forensic-analysis
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ── Logstash ──────────────────────────────
LS_JAVA_OPTS=-Xms512m -Xmx512m

# ── Zeek ──────────────────────────────────
ZEEK_INTERFACE=eno12399

# ── FastAPI ───────────────────────────────
SECRET_KEY=change_me_jwt_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_PORT=8000
DEBUG=false

# ── Ollama + Mistral ──────────────────────
OLLAMA_HOST=forenhive-ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=mistral

# ── APIs externes ─────────────────────────
ABUSEIPDB_API_KEY=your_key_here
VIRUSTOTAL_API_KEY=your_key_here
MAXMIND_LICENSE_KEY=your_key_here
SHODAN_KEY=your_key_here

# ── RFC 3161 TSA ──────────────────────────
TSA_URL=https://timestamp.digicert.com

# ── Nginx ─────────────────────────────────
DOMAIN=localhost
