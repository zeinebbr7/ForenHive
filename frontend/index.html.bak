<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ForenHive — Open Source Honeypot & Forensic Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#08040F;--bg2:#0D0719;--bg3:#120B22;--surface:#1A1030;--surface2:#221540;
  --gold:#FF6B1A;--gold2:#FF9A4D;--gold-glow:rgba(255,107,26,0.15);
  --red:#C0392B;--red2:#FF6B6B;--blue:#1A4FBB;--blue2:#6AB0FF;
  --purple:#7B2FBE;--purple2:#BF7FFF;--teal:#00BFA5;
  --text:#F5EEFF;--text2:#C4B0E8;--text3:#806699;
  --border:rgba(255,107,26,0.12);--border2:rgba(255,107,26,0.28);
  --r:rgba(192,57,43,0.15);--b:rgba(26,79,187,0.12);
}
html{scroll-behavior:smooth}
body{background:var(--bg);font-family:'Space Grotesk',sans-serif;color:var(--text);overflow-x:hidden}
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--gold);border-radius:3px}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:0;opacity:.5}
.grid-bg{position:fixed;inset:0;background-image:linear-gradient(rgba(255,107,26,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(123,47,190,0.025) 1px,transparent 1px);background-size:60px 60px;pointer-events:none;z-index:0}
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:0 5%;height:68px;background:rgba(8,4,15,0.88);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.nav-logo-hex{font-size:22px;color:var(--gold)}
.nav-logo-name{font-size:18px;font-weight:700;color:var(--gold);letter-spacing:2px;font-family:'Rajdhani',sans-serif}
.nav-logo-badge{font-size:9px;color:var(--text3);font-family:'Share Tech Mono',monospace;background:var(--surface);padding:2px 6px;border-radius:3px;border:1px solid var(--border)}
.nav-links{display:flex;align-items:center;gap:2rem}
.nav-links a{font-size:14px;font-weight:500;color:var(--text2);text-decoration:none;transition:color .2s}
.nav-links a:hover{color:var(--text)}
.nav-cta{display:flex;gap:10px;align-items:center}
.btn-ghost{padding:8px 18px;border:1px solid var(--border2);color:var(--gold);border-radius:5px;font-size:13px;font-weight:600;text-decoration:none;transition:all .2s;font-family:'Rajdhani',sans-serif;letter-spacing:.5px}
.btn-ghost:hover{background:var(--gold-glow)}
.btn-primary{padding:8px 20px;background:var(--gold);color:#08040F;border-radius:5px;font-size:13px;font-weight:700;text-decoration:none;transition:all .2s;font-family:'Rajdhani',sans-serif;letter-spacing:.5px}
.btn-primary:hover{background:var(--gold2);transform:translateY(-1px)}
.hero{position:relative;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:120px 5% 80px;text-align:center;overflow:hidden}
.hero-glow{position:absolute;top:15%;left:50%;transform:translateX(-50%);width:800px;height:500px;background:radial-gradient(ellipse,rgba(255,107,26,0.14) 0%,rgba(123,47,190,0.06) 50%,transparent 70%);pointer-events:none}
.hero-glow2{position:absolute;top:35%;left:10%;width:500px;height:400px;background:radial-gradient(ellipse,rgba(192,57,43,0.09) 0%,transparent 70%);pointer-events:none}
.hero-glow3{position:absolute;top:35%;right:5%;width:450px;height:400px;background:radial-gradient(ellipse,rgba(123,47,190,0.10) 0%,transparent 70%);pointer-events:none}
.hero-glow4{position:absolute;bottom:-10%;left:50%;transform:translateX(-50%);width:600px;height:300px;background:radial-gradient(ellipse,rgba(255,107,26,0.07) 0%,transparent 70%);pointer-events:none}
.hero-tag{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-family:'Share Tech Mono',monospace;color:var(--gold);background:rgba(255,107,26,0.08);border:1px solid var(--border2);padding:6px 14px;border-radius:20px;margin-bottom:28px;animation:fadeUp .6s ease both}
.hero-tag-dot{width:6px;height:6px;background:var(--teal);border-radius:50%;animation:blink 1.4s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.hero-h1{font-size:clamp(2.8rem,6vw,5.2rem);font-weight:700;line-height:1.1;letter-spacing:-1px;margin-bottom:24px;animation:fadeUp .6s .1s ease both}
.hero-h1 span{background:linear-gradient(135deg,var(--gold),var(--gold2),var(--purple2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero-sub{font-size:1.15rem;color:var(--text2);max-width:580px;line-height:1.7;margin-bottom:40px;animation:fadeUp .6s .2s ease both}
.hero-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;animation:fadeUp .6s .3s ease both}
.btn-lg{padding:14px 32px;border-radius:6px;font-size:15px;font-weight:700;text-decoration:none;font-family:'Rajdhani',sans-serif;letter-spacing:.5px;transition:all .25s}
.btn-lg.gold{background:linear-gradient(135deg,var(--gold),#E05500);color:#08040F}
.btn-lg.gold:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(255,107,26,0.4)}
.btn-lg.outline{border:1px solid var(--border2);color:var(--gold)}
.btn-lg.outline:hover{background:var(--gold-glow);transform:translateY(-2px)}
.hero-mockup{position:relative;margin-top:60px;width:100%;max-width:900px;animation:fadeUp .8s .4s ease both}
.mockup-frame{background:var(--bg2);border:1px solid var(--border2);border-radius:12px;overflow:hidden;box-shadow:0 40px 100px rgba(0,0,0,.7),0 0 60px rgba(255,107,26,0.05),0 0 0 1px var(--border);}
.mockup-bar{background:var(--surface);padding:10px 16px;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border)}
.mockup-dot{width:11px;height:11px;border-radius:50%}
.mockup-url{flex:1;margin:0 12px;background:var(--bg3);border-radius:4px;padding:4px 12px;font-size:11px;font-family:'Share Tech Mono',monospace;color:var(--text3);border:1px solid var(--border)}
.mockup-body{display:grid;grid-template-columns:160px 1fr;height:340px}
.mock-sidebar{background:var(--bg3);border-right:1px solid var(--border);padding:14px 0}
.mock-logo{padding:0 14px 14px;border-bottom:1px solid var(--border);margin-bottom:8px}
.mock-logo-name{font-size:13px;font-weight:700;color:var(--gold);font-family:'Rajdhani',sans-serif;letter-spacing:1px}
.mock-logo-sub{font-size:9px;color:var(--text3);font-family:'Share Tech Mono',monospace}
.mock-nav-item{display:flex;align-items:center;gap:8px;padding:9px 14px;font-size:12px;color:var(--text3);font-weight:500}
.mock-nav-item.a{color:var(--gold);background:rgba(255,107,26,0.08);border-left:2px solid var(--gold)}
.mock-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.mock-main{padding:14px;overflow:hidden}
.mock-topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.mock-title{font-size:13px;font-weight:600;color:var(--text)}
.mock-live{display:flex;align-items:center;gap:6px;font-size:10px;font-family:'Share Tech Mono',monospace;color:var(--text3)}
.mock-live-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);animation:pulse2 1.5s infinite}
@keyframes pulse2{0%,100%{opacity:1}50%{opacity:.4}}
.mock-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px}
.mock-card{border-radius:6px;padding:10px 12px}
.mock-card.r{background:rgba(192,57,43,0.12);border:1px solid rgba(192,57,43,0.28)}
.mock-card.g{background:rgba(255,107,26,0.10);border:1px solid rgba(255,107,26,0.25)}
.mock-card.b{background:rgba(26,79,187,0.12);border:1px solid rgba(26,79,187,0.28)}
.mock-card.p{background:rgba(123,47,190,0.12);border:1px solid rgba(123,47,190,0.28)}
.mock-cl{font-size:9px;color:var(--text3);font-family:'Share Tech Mono',monospace;text-transform:uppercase;margin-bottom:4px}
.mock-cv{font-size:20px;font-weight:700}
.mock-cv.r{color:var(--red2)}.mock-cv.g{color:var(--gold)}.mock-cv.b{color:var(--blue2)}.mock-cv.p{color:var(--purple2)}
.mock-cs{font-size:9px;color:var(--text3);font-family:'Share Tech Mono',monospace}
.mock-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px}
.mock-panel{background:var(--bg3);border-radius:6px;padding:10px;border:1px solid var(--border)}
.mock-ph{font-size:9px;color:var(--text3);font-family:'Share Tech Mono',monospace;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px}
.mock-bar-row{display:flex;align-items:center;gap:6px;margin-bottom:5px}
.mock-bl{font-size:9px;color:var(--text2);width:50px;flex-shrink:0}
.mock-bt{flex:1;height:5px;background:rgba(255,255,255,0.06);border-radius:3px;overflow:hidden}
.mock-bf{height:100%;border-radius:3px}
.mock-bv{font-size:9px;color:var(--text3);font-family:'Share Tech Mono',monospace;min-width:14px;text-align:right}
.mock-log-row{display:flex;gap:6px;padding:4px 0;border-bottom:1px solid rgba(255,107,26,0.04);font-family:'Share Tech Mono',monospace;font-size:9px}
.mock-lt{color:var(--text3);min-width:45px}
.mock-ls{min-width:45px;font-weight:600}
.mock-li{min-width:85px;color:var(--text2)}
.mock-lm{flex:1;color:var(--text3);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.stats-band{position:relative;padding:60px 5%;z-index:1;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--bg2)}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;max-width:1100px;margin:0 auto}
.stat-item{text-align:center;padding:20px}
.stat-num{font-size:3rem;font-weight:700;color:var(--gold);font-family:'Rajdhani',sans-serif;line-height:1}
.stat-num span{font-size:1.5rem}
.stat-label{font-size:13px;color:var(--text2);margin-top:6px}
section{position:relative;z-index:1;padding:100px 5%}
.section-tag{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-family:'Share Tech Mono',monospace;color:var(--gold);background:rgba(255,107,26,0.08);border:1px solid var(--border2);padding:4px 12px;border-radius:20px;margin-bottom:20px}
.section-h2{font-size:clamp(2rem,4vw,3rem);font-weight:700;letter-spacing:-.5px;margin-bottom:16px;line-height:1.15}
.section-h2 span{background:linear-gradient(135deg,var(--gold),var(--purple2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.section-p{font-size:1.05rem;color:var(--text2);line-height:1.75;max-width:520px}
.features{padding:100px 5%;max-width:1300px;margin:0 auto}
.features-intro{text-align:center;margin-bottom:60px}
.features-intro .section-p{max-width:600px;margin:0 auto}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.feat-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:28px;transition:all .3s;position:relative;overflow:hidden}
.feat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),var(--purple2),transparent);opacity:0;transition:opacity .3s}
.feat-card:hover{border-color:var(--border2);transform:translateY(-4px);box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 30px rgba(255,107,26,0.04)}
.feat-card:hover::before{opacity:1}
.feat-icon{width:44px;height:44px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:18px}
.feat-icon.r{background:rgba(192,57,43,0.12);border:1px solid rgba(192,57,43,0.28)}
.feat-icon.g{background:rgba(255,107,26,0.12);border:1px solid rgba(255,107,26,0.28)}
.feat-icon.b{background:rgba(26,79,187,0.12);border:1px solid rgba(26,79,187,0.28)}
.feat-icon.p{background:rgba(123,47,190,0.14);border:1px solid rgba(123,47,190,0.30)}
.feat-icon.t{background:rgba(0,191,165,0.10);border:1px solid rgba(0,191,165,0.25)}
.feat-icon.o{background:rgba(255,154,77,0.12);border:1px solid rgba(255,154,77,0.28)}
.feat-title{font-size:17px;font-weight:700;color:var(--text);margin-bottom:10px;font-family:'Rajdhani',sans-serif;letter-spacing:.5px}
.feat-desc{font-size:14px;color:var(--text2);line-height:1.65}
.feat-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
.feat-tag{font-size:10px;font-family:'Share Tech Mono',monospace;color:var(--text3);background:var(--bg3);border:1px solid var(--border);padding:3px 8px;border-radius:4px}
.platform{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.platform-inner{max-width:1200px;margin:0 auto;padding:100px 5%;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.platform-visual{position:relative}
.platform-card{background:var(--surface);border:1px solid var(--border2);border-radius:10px;padding:24px;margin-bottom:14px;transition:all .3s}
.platform-card:hover{border-color:var(--gold);transform:translateX(6px);box-shadow:0 0 20px rgba(255,107,26,0.06)}
.pc-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.pc-title{font-size:15px;font-weight:700;color:var(--text);font-family:'Rajdhani',sans-serif;letter-spacing:.5px}
.pc-badge{font-size:10px;font-family:'Share Tech Mono',monospace;padding:3px 8px;border-radius:4px}
.pc-badge.active{background:rgba(0,191,165,0.10);color:var(--teal);border:1px solid rgba(0,191,165,0.25)}
.pc-badge.critical{background:rgba(192,57,43,0.12);color:var(--red2);border:1px solid rgba(192,57,43,0.28)}
.pc-badges{display:flex;flex-wrap:wrap;gap:6px}
.pc-tag{font-size:11px;font-family:'Share Tech Mono',monospace;color:var(--text3);background:var(--bg3);padding:4px 10px;border-radius:4px;border:1px solid var(--border)}
.honeypots{max-width:1200px;margin:0 auto;padding:100px 5%}
.hp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:50px}
.hp-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:24px;text-align:center;transition:all .3s}
.hp-card:hover{border-color:var(--border2);transform:translateY(-6px);box-shadow:0 20px 50px rgba(0,0,0,.5),0 0 20px rgba(255,107,26,0.05)}
.hp-icon{font-size:2.5rem;margin-bottom:16px}
.hp-name{font-size:18px;font-weight:700;color:var(--text);font-family:'Rajdhani',sans-serif;letter-spacing:1px;margin-bottom:8px}
.hp-desc{font-size:13px;color:var(--text2);line-height:1.6;margin-bottom:16px}
.hp-stat{font-size:11px;font-family:'Share Tech Mono',monospace;color:var(--gold);background:var(--gold-glow);border:1px solid var(--border2);padding:5px 12px;border-radius:20px}
.mitre{background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.mitre-inner{max-width:1200px;margin:0 auto;padding:100px 5%}
.mitre-header{text-align:center;margin-bottom:60px}
.mitre-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.mitre-col{background:var(--surface);border:1px solid var(--border);border-radius:8px;overflow:hidden}
.mitre-col-hdr{padding:10px 12px;font-size:10px;font-family:'Share Tech Mono',monospace;font-weight:600;text-align:center;border-bottom:1px solid var(--border)}
.mitre-col-hdr.r{color:var(--red2);background:rgba(192,57,43,0.08)}
.mitre-col-hdr.g{color:var(--gold);background:rgba(255,107,26,0.08)}
.mitre-col-hdr.b{color:var(--blue2);background:rgba(26,79,187,0.08)}
.mitre-col-hdr.p{color:var(--purple2);background:rgba(123,47,190,0.08)}
.mitre-col-hdr.t{color:#80CBC4;background:rgba(0,191,165,0.08)}
.mitre-col-hdr.o{color:var(--gold2);background:rgba(255,154,77,0.08)}
.mitre-col-hdr.w{color:#B0BEC5;background:rgba(96,125,139,0.08)}
.mitre-item{padding:6px 10px;font-size:9.5px;color:var(--text3);font-family:'Share Tech Mono',monospace;border-bottom:1px solid rgba(255,107,26,0.04);transition:all .2s;cursor:default}
.mitre-item:hover{background:rgba(255,107,26,0.05);color:var(--text2)}
.mitre-item.hit{color:var(--gold);background:rgba(255,107,26,0.06)}
.mitre-item.crit{color:var(--red2);background:rgba(192,57,43,0.07)}
.testimonials{max-width:1200px;margin:0 auto;padding:100px 5%}
.test-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:50px}
.test-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:28px;transition:all .3s}
.test-card:hover{border-color:var(--border2);transform:translateY(-4px)}
.test-quote{font-size:14px;color:var(--text2);line-height:1.75;margin-bottom:24px;font-style:italic}
.test-quote::before{content:'"';font-size:3rem;color:var(--gold);opacity:.3;display:block;line-height:.5;margin-bottom:12px;font-style:normal}
.test-author{display:flex;align-items:center;gap:12px}
.test-avatar{width:38px;height:38px;border-radius:50%;background:var(--surface2);border:2px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.test-name{font-size:14px;font-weight:700;color:var(--text);font-family:'Rajdhani',sans-serif}
.test-role{font-size:11px;color:var(--text3);font-family:'Share Tech Mono',monospace}
.cta-section{position:relative;padding:120px 5%;text-align:center;background:radial-gradient(ellipse at center,rgba(255,107,26,0.09) 0%,rgba(123,47,190,0.05) 50%,transparent 70%)}
.cta-section::before{content:'';position:absolute;inset:0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.cta-h2{font-size:clamp(2rem,4vw,3.2rem);font-weight:700;margin-bottom:20px;letter-spacing:-.5px}
.cta-h2 span{background:linear-gradient(135deg,var(--gold),var(--purple2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.cta-p{font-size:1.05rem;color:var(--text2);line-height:1.75;max-width:540px;margin:0 auto 40px}
.cta-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
footer{background:var(--bg2);border-top:1px solid var(--border);padding:60px 5% 30px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;max-width:1200px;margin:0 auto 50px}
.footer-brand .logo-name{font-size:20px;font-weight:700;color:var(--gold);font-family:'Rajdhani',sans-serif;letter-spacing:2px;margin-bottom:12px}
.footer-desc{font-size:13px;color:var(--text3);line-height:1.7;max-width:260px;margin-bottom:20px}
.footer-socials{display:flex;gap:10px}
.social-btn{width:34px;height:34px;border-radius:6px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--text3);text-decoration:none;transition:all .2s}
.social-btn:hover{border-color:var(--border2);color:var(--gold)}
.footer-col h4{font-size:12px;font-family:'Share Tech Mono',monospace;color:var(--gold);letter-spacing:1px;text-transform:uppercase;margin-bottom:16px}
.footer-col a{display:block;font-size:13px;color:var(--text2);text-decoration:none;margin-bottom:10px;transition:color .2s}
.footer-col a:hover{color:var(--text)}
.footer-bottom{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;padding-top:24px;border-top:1px solid var(--border);font-size:12px;color:var(--text3);font-family:'Share Tech Mono',monospace}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.fade-in{opacity:0;transform:translateY(24px);transition:all .7s ease}
.fade-in.visible{opacity:1;transform:translateY(0)}
@media(max-width:900px){.feat-grid{grid-template-columns:1fr 1fr}.platform-inner{grid-template-columns:1fr}.hp-grid{grid-template-columns:1fr 1fr}.mitre-grid{grid-template-columns:repeat(4,1fr)}.test-grid{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}.stats-grid{grid-template-columns:1fr 1fr}.nav-links{display:none}.mockup-body{grid-template-columns:1fr}.mock-sidebar{display:none}}
@media(max-width:600px){.feat-grid{grid-template-columns:1fr}.hp-grid{grid-template-columns:1fr}.mitre-grid{grid-template-columns:repeat(2,1fr)}.footer-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="grid-bg"></div>
<nav>
  <a href="#" class="nav-logo"><span class="nav-logo-hex">⬡</span><span class="nav-logo-name">FORENHIVE</span><span class="nav-logo-badge">v1.0</span></a>
  <div class="nav-links"><a href="#platform">Plateforme</a><a href="#honeypots">Honeypots</a><a href="#mitre">MITRE ATT&amp;CK</a><a href="#docs">Documentation</a><a href="#community">Communauté</a></div>
  <div class="nav-cta"><a href="pages/login.html" class="btn-ghost">Log in</a><a href="pages/login.html" class="btn-primary">Installer ForenHive</a></div>
</nav>
<section class="hero">
  <div class="hero-glow"></div><div class="hero-glow2"></div><div class="hero-glow3"></div><div class="hero-glow4"></div>
  <div class="hero-tag"><span class="hero-tag-dot"></span>Open Source · Honeypot + Forensique + SIEM</div>
  <h1 class="hero-h1">La plateforme de sécurité<br><span>open source unifiée</span></h1>
  <p class="hero-sub">Détection avancée des menaces, analyse forensique certifiée et réponse aux incidents — pour endpoints, honeypots et workloads cloud.</p>
  <div class="hero-btns"><a href="pages/login.html" class="btn-lg gold">Installer ForenHive</a><a href="pages/login.html" class="btn-lg outline">Essai Cloud Gratuit</a></div>
  <div class="hero-mockup">
    <div class="mockup-frame">
      <div class="mockup-bar">
        <div class="mockup-dot" style="background:#ff5f57"></div><div class="mockup-dot" style="background:#febc2e"></div><div class="mockup-dot" style="background:#28c840"></div>
        <div class="mockup-url">🔒 forenhive.local / dashboard</div>
      </div>
      <div class="mockup-body">
        <div class="mock-sidebar">
          <div class="mock-logo"><div class="mock-logo-name">⬡ FORENHIVE</div><div class="mock-logo-sub">SOC Platform v1.0</div></div>
          <div class="mock-nav-item a"><div class="mock-dot" style="background:var(--gold)"></div>Dashboard</div>
          <div class="mock-nav-item"><div class="mock-dot" style="background:var(--blue)"></div>Statistiques</div>
          <div class="mock-nav-item"><div class="mock-dot" style="background:var(--red)"></div>Carte géo</div>
          <div class="mock-nav-item"><div class="mock-dot" style="background:var(--red2)"></div>Sessions</div>
          <div class="mock-nav-item"><div class="mock-dot" style="background:var(--gold2)"></div>Détail session</div>
          <div class="mock-nav-item"><div class="mock-dot" style="background:var(--blue2)"></div>Rapport PDF</div>
        </div>
        <div class="mock-main">
          <div class="mock-topbar"><div class="mock-title">Dashboard — Vue d'ensemble</div><div class="mock-live"><span class="mock-live-dot"></span> LIVE · 13:47:22</div></div>
          <div class="mock-cards">
            <div class="mock-card g"><div class="mock-cl">Sessions</div><div class="mock-cv g">48</div><div class="mock-cs">+12 ce mois</div></div>
            <div class="mock-card r"><div class="mock-cl">Critical</div><div class="mock-cv r">7</div><div class="mock-cs">score ≥ 80</div></div>
            <div class="mock-card b"><div class="mock-cl">IPs enrichies</div><div class="mock-cv b">23</div><div class="mock-cs">5 nœuds Tor</div></div>
            <div class="mock-card p"><div class="mock-cl">YARA matches</div><div class="mock-cv p">4</div><div class="mock-cs">Mirai · XMRig</div></div>
          </div>
          <div class="mock-grid">
            <div class="mock-panel">
              <div class="mock-ph">Par honeypot</div>
              <div class="mock-bar-row"><div class="mock-bl">Cowrie</div><div class="mock-bt"><div class="mock-bf" style="width:52%;background:var(--gold)"></div></div><div class="mock-bv">25</div></div>
              <div class="mock-bar-row"><div class="mock-bl">Dionaea</div><div class="mock-bt"><div class="mock-bf" style="width:21%;background:var(--red)"></div></div><div class="mock-bv">10</div></div>
              <div class="mock-bar-row"><div class="mock-bl">Galah</div><div class="mock-bt"><div class="mock-bf" style="width:27%;background:var(--blue)"></div></div><div class="mock-bv">13</div></div>
              <div class="mock-bar-row"><div class="mock-bl">Zeek</div><div class="mock-bt"><div class="mock-bf" style="width:10%;background:var(--purple)"></div></div><div class="mock-bv">5</div></div>
            </div>
            <div class="mock-panel">
              <div class="mock-ph">Live logs — temps réel</div>
              <div class="mock-log-row"><div class="mock-lt">13:47:18</div><div class="mock-ls" style="color:var(--gold)">cowrie</div><div class="mock-li">185.220.101.5</div><div class="mock-lm">SSH brute force — root/mongo123 ✗</div></div>
              <div class="mock-log-row"><div class="mock-lt">13:47:19</div><div class="mock-ls" style="color:var(--red2)">dionaea</div><div class="mock-li">45.33.32.156</div><div class="mock-lm">EternalBlue probe on :445</div></div>
              <div class="mock-log-row"><div class="mock-lt">13:47:20</div><div class="mock-ls" style="color:var(--blue2)">galah</div><div class="mock-li">192.241.x.x</div><div class="mock-lm">GET /wp-admin HTTP/1.1</div></div>
              <div class="mock-log-row"><div class="mock-lt">13:47:21</div><div class="mock-ls" style="color:var(--text2)">zeek</div><div class="mock-li">10.212.x.x</div><div class="mock-lm">TCP SYN scan detected</div></div>
              <div class="mock-log-row"><div class="mock-lt">13:47:22</div><div class="mock-ls" style="color:var(--gold)">cowrie</div><div class="mock-li">185.220.101.5</div><div class="mock-lm">CMD: wget http://bot.sh — Mirai ⚠</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<div class="stats-band">
  <div class="stats-grid">
    <div class="stat-item fade-in"><div class="stat-num">48<span>K+</span></div><div class="stat-label">Sessions analysées</div></div>
    <div class="stat-item fade-in"><div class="stat-num">11<span>M+</span></div><div class="stat-label">Logs indexés</div></div>
    <div class="stat-item fade-in"><div class="stat-num">4</div><div class="stat-label">Honeypots intégrés</div></div>
    <div class="stat-item fade-in"><div class="stat-num">100<span>%</span></div><div class="stat-label">Open Source</div></div>
  </div>
</div>
<div class="features" id="platform">
  <div class="features-intro fade-in">
    <div class="section-tag">⬡ Capacités</div>
    <h2 class="section-h2">Endpoint, Cloud et <span>Honeypots</span></h2>
    <p class="section-p">ForenHive unifie la détection, la capture forensique et la réponse aux incidents dans une architecture agent + plateforme unique.</p>
  </div>
  <div class="feat-grid">
    <div class="feat-card fade-in"><div class="feat-icon r">🎯</div><div class="feat-title">Honeypot Multi-Capteur</div><div class="feat-desc">Intégration native de Cowrie, Dionaea, Galah et Zeek. Corrélation automatique des événements inter-honeypots.</div><div class="feat-tags"><span class="feat-tag">Cowrie</span><span class="feat-tag">Dionaea</span><span class="feat-tag">Galah</span><span class="feat-tag">Zeek</span></div></div>
    <div class="feat-card fade-in"><div class="feat-icon g">🧠</div><div class="feat-title">Analyse Forensique IA</div><div class="feat-desc">Mistral 7B local via Ollama. Scoring de sessions automatique, détection d'anomalies et génération de rapports narratifs.</div><div class="feat-tags"><span class="feat-tag">Mistral 7B</span><span class="feat-tag">Ollama</span><span class="feat-tag">YARA</span></div></div>
    <div class="feat-card fade-in"><div class="feat-icon b">🛡️</div><div class="feat-title">MITRE ATT&amp;CK Mapping</div><div class="feat-desc">Cartographie automatique des techniques MITRE. Kill chain scoring, pivot inter-sessions, heat maps tactiques.</div><div class="feat-tags"><span class="feat-tag">T1110</span><span class="feat-tag">T1078</span><span class="feat-tag">T1105</span></div></div>
    <div class="feat-card fade-in"><div class="feat-icon p">📜</div><div class="feat-title">Rapports Certifiés RFC 3161</div><div class="feat-desc">Génération PDF automatique avec horodatage TSA (freeTSA.org), SHA-256 et chaîne de custody. Admissible légalement.</div><div class="feat-tags"><span class="feat-tag">RFC 3161</span><span class="feat-tag">SHA-256</span><span class="feat-tag">WeasyPrint</span></div></div>
    <div class="feat-card fade-in"><div class="feat-icon t">🌍</div><div class="feat-title">Enrichissement IP &amp; Géo</div><div class="feat-desc">AbuseIPDB, VirusTotal, Shodan. Détection automatique de nœuds Tor, VPN et infrastructures connues d'attaquants.</div><div class="feat-tags"><span class="feat-tag">AbuseIPDB</span><span class="feat-tag">VirusTotal</span><span class="feat-tag">Shodan</span></div></div>
    <div class="feat-card fade-in"><div class="feat-icon o">⚡</div><div class="feat-title">SIEM Temps Réel</div><div class="feat-desc">Pipeline Logstash → Elasticsearch → Kibana. Live logs, alerting Sigma, tableaux de bord personnalisables.</div><div class="feat-tags"><span class="feat-tag">Elasticsearch</span><span class="feat-tag">Sigma</span><span class="feat-tag">Logstash</span></div></div>
  </div>
</div>
<div class="honeypots" id="honeypots">
  <div class="fade-in" style="text-align:center">
    <div class="section-tag">🎯 Honeypots</div>
    <h2 class="section-h2">Quatre capteurs, <span>une vision unifiée</span></h2>
    <p class="section-p" style="margin:0 auto">Chaque honeypot capture un vecteur d'attaque distinct. ForenHive les corrèle automatiquement pour reconstituer la kill chain complète.</p>
  </div>
  <div class="hp-grid">
    <div class="hp-card fade-in"><div class="hp-icon">🦐</div><div class="hp-name">COWRIE</div><div class="hp-desc">SSH/Telnet honeypot. Capture brute force, sessions interactives, commandes exécutées et fichiers téléchargés.</div><div class="hp-stat">SSH · Telnet · SCP</div></div>
    <div class="hp-card fade-in"><div class="hp-icon">🦑</div><div class="hp-name">DIONAEA</div><div class="hp-desc">Multi-protocoles : SMB, HTTP, FTP, MySQL, MSSQL. Capture malwares, exploits et binaires en mémoire.</div><div class="hp-stat">SMB · MySQL · Malware</div></div>
    <div class="hp-card fade-in"><div class="hp-icon">🦀</div><div class="hp-name">GALAH</div><div class="hp-desc">HTTP honeypot boosté par LLM. Génère des réponses réalistes pour piéger les bots et scanners web.</div><div class="hp-stat">HTTP · LLM · Web Scan</div></div>
    <div class="hp-card fade-in"><div class="hp-icon">🦂</div><div class="hp-name">ZEEK</div><div class="hp-desc">Analyse réseau passive. Détecte scans, NTLM, DNS suspects et cartographie les connexions réseau.</div><div class="hp-stat">Network · IDS · DNS</div></div>
  </div>
</div>
<section class="cta-section">
  <div class="section-tag" style="margin:0 auto 24px">🚀 Commencer</div>
  <h2 class="cta-h2">Prêt à déployer<br><span>ForenHive</span> ?</h2>
  <p class="cta-p">100% open source, sans licence, sans vendor lock-in. Déployable on-premises ou en cloud en moins de 15 minutes.</p>
  <div class="cta-btns"><a href="pages/login.html" class="btn-lg gold">Installer ForenHive</a><a href="#" class="btn-lg outline">Lire la documentation</a></div>
</section>
<footer>
  <div class="footer-grid">
    <div class="footer-brand"><div class="logo-name">⬡ FORENHIVE</div><p class="footer-desc">Plateforme open source unifiée pour la détection des menaces, l'analyse forensique et la réponse aux incidents.</p><div class="footer-socials"><a href="#" class="social-btn">🔗</a><a href="#" class="social-btn">🐦</a><a href="#" class="social-btn">💬</a><a href="#" class="social-btn">📘</a></div></div>
    <div class="footer-col"><h4>Plateforme</h4><a href="#">Vue d'ensemble</a><a href="#">Honeypots</a><a href="#">SIEM</a><a href="#">Forensique</a></div>
    <div class="footer-col"><h4>Documentation</h4><a href="#">Quickstart</a><a href="#">Installation</a><a href="#">API Reference</a></div>
    <div class="footer-col"><h4>Communauté</h4><a href="#">GitHub</a><a href="#">Discord</a><a href="#">Blog</a></div>
  </div>
  <div class="footer-bottom"><span>© 2026 ForenHive · Open Source Security Platform</span><span>GPL-3.0 · Made in Tunisia 🇹🇳</span></div>
</footer>
<script>
const obs = new IntersectionObserver((entries) => { entries.forEach((e, i) => { if(e.isIntersecting) setTimeout(() => e.target.classList.add('visible'), i * 80); }); }, {threshold: 0.1});
document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
window.addEventListener('scroll', () => { const nav = document.querySelector('nav'); nav.style.background = window.scrollY > 50 ? 'rgba(8,4,15,0.97)' : 'rgba(8,4,15,0.88)'; });
</script>
</body>
</html>
