    <!-- ═══════════════════════════════════════════════════════════════
         RELATIONSHIPS / EDGES
         Each edge uses explicit exitX/exitY + entryX/entryY so that
         draw.io draws straight horizontal or vertical lines.
         Positions derived from actual table coordinates:
           forensic_sessions      x=360  y=440  w=280  h=630
           forensic_timeline_events x=680  y=440  w=280  h=342
           forensic_iocs          x=680  y=820  w=280  h=294
           forensic_chain_of_cust x=1000 y=440  w=280  h=198
           forensic_coc_batches   x=1000 y=680  w=280  h=246
           ip_risk_scores         x=20   y=470  w=280  h=414
           suspect_profiles       x=20   y=934  w=280  h=174
           users                  x=670  y=50   w=280  h=222
           audit_log              x=990  y=50   w=280  h=342
    ═══════════════════════════════════════════════════════════════ -->

    <!--
      1. forensic_sessions ──FK (ON DELETE CASCADE)── forensic_chain_of_custody
         Both tables start at y=440. Route goes ABOVE all tables (y=415) to avoid
         crossing through forensic_timeline_events.
         Exit: sessions top-center (500, 440) → waypoint (500, 415) → waypoint (1140, 415)
         Entry: coc top-center (1140, 440)
    -->
    <mxCell id="2001" value="session_id [FK · CASCADE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#E74C3C;strokeWidth=2;startArrow=ERmandOne;startFill=1;endArrow=ERmandOne;endFill=1;fontStyle=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="100" target="400" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="500" y="415" />
          <mxPoint x="1140" y="415" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!--
      2. forensic_sessions → forensic_timeline_events  (logical 1:N, session_id)
         timeline center-y = 440 + 342/2 = 611.
         exitY on sessions = (611-440)/630 = 0.271  → exit point (640, 611)
         entry left-center of timeline                → entry point (680, 611)
         Result: perfectly straight horizontal line.
    -->
    <mxCell id="2002" value="session_id (logical)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#6C8EBF;strokeWidth=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=10;exitX=1;exitY=0.271;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="100" target="200" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!--
      3. forensic_sessions → forensic_iocs  (logical 1:N, source_ip)
         iocs center-y = 820 + 294/2 = 967.  967 > 782 (bottom of timeline) → no crossing.
         exitY on sessions = (967-440)/630 = 0.836  → exit point (640, 967)
         entry left-center of iocs                   → entry point (680, 967)
         Result: straight horizontal line, below timeline_events.
    -->
    <mxCell id="2003" value="source_ip (logical)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#6C8EBF;strokeWidth=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=10;exitX=1;exitY=0.836;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="100" target="300" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!--
      4. forensic_chain_of_custody → forensic_coc_batches  (logical N:1, batch_id)
         Same column (x=1000-1280). coc bottom (y=638) to batches top (y=680).
         Straight vertical line, 42 px gap.
    -->
    <mxCell id="2004" value="batch_id (logical)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#6C8EBF;strokeWidth=1;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="400" target="500" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!--
      5. forensic_sessions → ip_risk_scores  (logical 1:1, source_ip → PK)
         ip_risk_scores center-y = 470 + 414/2 = 677.
         exitY on sessions = (677-440)/630 = 0.376  → exit point (360, 677)
         entry right-center of ip_risk_scores        → entry point (300, 677)
         Result: straight horizontal line going left.
    -->
    <mxCell id="2005" value="source_ip → PK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#6C8EBF;strokeWidth=1;startArrow=ERone;startFill=0;endArrow=ERone;endFill=0;fontSize=10;exitX=0;exitY=0.376;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="100" target="1000" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!--
      6. forensic_sessions → suspect_profiles  (logical 1:1, source_ip → UQ)
         suspect_profiles center-y = 934 + 174/2 = 1021.
         exitY on sessions = (1021-440)/630 = 0.922  → exit point (360, 1021)
         entry right-center of suspect_profiles       → entry point (300, 1021)
         Result: straight horizontal line going left, near bottom of sessions.
    -->
    <mxCell id="2006" value="source_ip → UQ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#6C8EBF;strokeWidth=1;startArrow=ERone;startFill=0;endArrow=ERone;endFill=0;fontSize=10;exitX=0;exitY=0.922;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="100" target="800" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!--
      7. forensic_timeline_events → forensic_iocs  (IOC extraction, no FK)
         Same column (x=680-960). timeline bottom (y=782) to iocs top (y=820).
         Straight vertical line, 38 px gap.
    -->
    <mxCell id="2007" value="IOC extraction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#9E9E9E;strokeWidth=1;startArrow=none;endArrow=open;endFill=0;fontSize=10;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="200" target="300" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!--
      8. audit_log → users  (logical N:1, actor_id → id)
         Both in auth group. users center-y = 50 + 222/2 = 161.
         exitY on audit_log = (161-50)/342 = 0.325  → exit point (990, 161)
         entry right-center of users                 → entry point (950, 161)
         Result: straight horizontal line going left.
    -->
    <mxCell id="2008" value="actor_id → id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#9B59B6;strokeWidth=1;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;fontSize=10;exitX=0;exitY=0.325;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="1200" target="1100" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
