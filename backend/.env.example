# ── ForenHive Backend — .env.example ──────────────────

# FastAPI
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# CORS
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Auth / JWT
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@forenhive.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
DISABLE_AUTH=false

# PostgreSQL
PG_HOST=forenhive-postgresql
PG_PORT=5432
PG_DB=forenhive
PG_USER=forenhive
PG_PASSWORD=change_me

# Elasticsearch
ES_HOST=http://elasticsearch:9200
ES_INDEX_COWRIE=cowrie-*
ES_INDEX_DIONAEA=dionaea-*
ES_INDEX_GALAH=galah-*
ES_INDEX_ZEEK=zeek-*
ES_INDEX_HONEYPOT=honeypot-logs-*
ES_INDEX_ALERTS=forenhive-alerts
ES_INDEX_PROFILES=forenhive-profiles
ES_INDEX_REPORTS=forenhive-reports
ES_REQUEST_TIMEOUT=30

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_TIMEOUT=30
OLLAMA_CACHE_TTL=3600

# Risk engine
RISK_ALERT_THRESHOLD=75
ALERT_DEDUP_WINDOW_MINUTES=15
ALERT_WATCHER_ENABLED=true
ALERT_WATCHER_INTERVAL_SECONDS=15

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=ForenHive Alerts <alerts@example.com>
SMTP_STARTTLS=true
ALERT_RECIPIENTS=soc@example.com,ciso@example.com

# External enrichment
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
IPLOCATE_API_KEY=

# Forensic engine (YARA / enrichment sidecar)
FORENSIC_ENGINE_URL=http://forensic-engine:8001
FORENSIC_ENGINE_TIMEOUT=30

# RFC 3161 Timestamp Authority
TSA_URL=https://freetsa.org/tsr
TSA_CERT_URL=https://freetsa.org/files/tsa.crt

# Reports
REPORTS_DIR=/reports

# Rate limiting (slowapi)
RATELIMIT_DEFAULT=200/minute
RATELIMIT_SENSITIVE=10/minute
