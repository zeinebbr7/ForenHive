# ══════════════════════════════════════════
# ForenHive — Variables d'environnement
# Copier ce fichier en .env et remplir
# ══════════════════════════════════════════

# ── PostgreSQL ────────────────────────────
POSTGRES_USER=forenhive
POSTGRES_PASSWORD=change_me_password
POSTGRES_DB=forenhive
PG_HOST=forenhive-postgresql
PG_PORT=5432
PG_USER=forenhive
PG_PASSWORD=change_me_password
PG_DB=forenhive

# ── Elasticsearch ─────────────────────────
ES_HOST=http://forenhive-elasticsearch:9200
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ── Logstash ──────────────────────────────
LS_JAVA_OPTS=-Xms512m -Xmx512m

# ── Zeek ──────────────────────────────────
ZEEK_INTERFACE=eno12399

# ── FastAPI ───────────────────────────────
JWT_SECRET=change_me_jwt_secret_key
API_PORT=8000

# ── Ollama + Mistral ──────────────────────
OLLAMA_HOST=http://forenhive-ollama:11434
OLLAMA_MODEL=mistral

# ── APIs externes ─────────────────────────
ABUSEIPDB_API_KEY=a3aa508f13507b19128640e9c7e6fe400118d09bd67e8ad47c355ac4fe19de29c2554929f0cb962a
VIRUSTOTAL_API_KEY=bc82918fbf0e058b4a038026c43842885b0470c2a63fb45a737ceae2b598d84d

# ── RFC 3161 TSA ──────────────────────────
TSA_URL=https://freetsa.org/tsr